{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Production MCP server for the production Convex deployment (different-gnu-398). Its routes take precedence over
  // revline-web's tryrevline.com custom domain for these paths; without them proxy.ts forwards the same paths to Convex.
  "name": "revline-mcp-production",
  "main": "worker.ts",
  "account_id": "701645e913477e567db69b11343f59d8",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "tryrevline.com/mcp", "zone_name": "tryrevline.com" },
    { "pattern": "tryrevline.com/mcp/*", "zone_name": "tryrevline.com" },
    { "pattern": "tryrevline.com/oauth/*", "zone_name": "tryrevline.com" },
    { "pattern": "tryrevline.com/.well-known/oauth-*", "zone_name": "tryrevline.com" },
    { "pattern": "tryrevline.com/.well-known/openid-configuration", "zone_name": "tryrevline.com" }
  ],
  // One Agents SDK McpAgent (a SQLite Durable Object) per MCP session.
  "durable_objects": { "bindings": [{ "name": "MCP_SESSION", "class_name": "RevlineMcp" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RevlineMcp"] }],
  // The OAuth provider's clients, grants and tokens (hashed). Created on first deploy.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // Dynamic client registrations per client IP, as the Convex server limited them.
  "ratelimits": [{ "name": "REGISTER_LIMIT", "namespace_id": "4102", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    "CONVEX_SITE_URL": "https://different-gnu-398.convex.site",
    // The address clients connect to; every token is bound to <MCP_ORIGIN>/mcp.
    "MCP_ORIGIN": "https://tryrevline.com",
    // Where the signed-in consent page (/connect) lives.
    "APP_ORIGIN": "https://tryrevline.com"
  },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false }, "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true } }
}
