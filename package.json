{
  "name": "revline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "skills:bundle": "node scripts/bundle-editor-skills.mjs",
    "skills:check": "node scripts/bundle-editor-skills.mjs --check",
    "pretypecheck": "npm run skills:check",
    "predev": "node scripts/copy-vendor.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:isolated": "node scripts/isolated-dev.mjs",
    "dev:isolated:cleanup": "node scripts/isolated-dev.mjs --cleanup",
    "dev:frontend": "next dev --hostname localhost --port 3001",
    "prebuild": "npm run skills:check && node scripts/copy-vendor.mjs",
    "build": "next build",
    "start": "next start --hostname localhost",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "node scripts/copy-vendor.mjs && node scripts/install-convex-guard.mjs",
    "convex:dev": "convex dev",
    "preworker": "node scripts/copy-vendor.mjs",
    "worker": "node --env-file=.env.local --import tsx scripts/media-worker.ts",
    "preworker:production": "node scripts/copy-vendor.mjs",
    "worker:production": "node --env-file=.env.production.local --import tsx scripts/media-worker.ts",
    "check": "npm run typecheck && npm run build",
    "skills:rank": "node --import tsx scripts/rank-skills.ts",
    "build:cloudflare": "node scripts/cloudflare-frontend.mjs build",
    "preview:cloudflare": "node scripts/cloudflare-frontend.mjs preview",
    "deploy:frontend": "node scripts/cloudflare-frontend.mjs deploy",
    "check:setup": "node scripts/check-setup.mjs",
    "deploy:frontend:ci": "npm run build:cloudflare && wrangler deploy --config dist/server/wrangler.json",
    "agent-runner:install": "npm ci --prefix cloudflare/agent-runner --legacy-peer-deps --no-audit --no-fund",
    "typecheck:agent-runner": "tsc -p cloudflare/agent-runner/tsconfig.json",
    "deploy:agent-runner": "npm run agent-runner:install && npm run typecheck:agent-runner && wrangler deploy --config cloudflare/agent-runner/wrangler.jsonc",
    "deploy:agent-runner:production": "npm run agent-runner:install && npm run typecheck:agent-runner && wrangler deploy --config cloudflare/agent-runner/wrangler.production.jsonc",
    "mcp:install": "npm ci --prefix cloudflare/mcp --legacy-peer-deps --no-audit --no-fund",
    "typecheck:mcp": "tsc -p cloudflare/mcp/tsconfig.json",
    "dev:mcp": "wrangler dev --config cloudflare/mcp/wrangler.jsonc --var MCP_ORIGIN:http://localhost:8787",
    "deploy:mcp": "npm run mcp:install && npm run typecheck:mcp && wrangler deploy --config cloudflare/mcp/wrangler.jsonc",
    "deploy:mcp:production": "npm run mcp:install && npm run typecheck:mcp && wrangler deploy --config cloudflare/mcp/wrangler.production.jsonc",
    "incidents:issues": "node --import tsx scripts/incident-listener/issues.ts",
    "incidents:listen": "node --import tsx scripts/incident-listener/index.ts",
    "incidents:install": "node --import tsx scripts/incident-listener/install.ts",
    "incidents:fix": "node scripts/fix-save-incidents.mjs",
    "typecheck:processor-edge": "tsc -p infra/media-worker/edge/tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/google": "4.0.95",
    "@ai-sdk/openai": "^4.0.94",
    "@apple/app-store-server-library": "^3.1.0",
    "@clerk/backend": "^3.23.2",
    "@clerk/nextjs": "^7.9.14",
    "@clerk/ui": "^1.40.0",
    "@convex-dev/agent": "^0.7.7",
    "@convex-dev/stripe": "^0.1.7",
    "@convex-dev/workflow": "0.4.10",
    "@fal-ai/client": "^1.10.1",
    "@hyperframes/core": "0.8.144",
    "@hyperframes/player": "0.8.144",
    "@hyperframes/producer": "0.8.143",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-wasm": "^2.4.1",
    "@sentry/nextjs": "^11.8.0",
    "@shadcn/react": "^0.3.1",
    "@vinext/cloudflare": "^1.1.1",
    "acorn": "^8.19.0",
    "ai": "^7.0.137",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "convex": "^1.46.0",
    "diff": "^9.0.0",
    "globals": "^17.13.0",
    "gsap": "^3.14.2",
    "imagetracerjs": "^1.2.6",
    "jose": "6.2.13",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "opentype.js": "^1.3.4",
    "posthog-js": "^1.438.12",
    "prettier": "^3.9.10",
    "puppeteer": "25.13.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.3",
    "react-server-dom-webpack": "^19.3.1",
    "stripe": "^22.6.2",
    "sucrase": "3.35.1",
    "sugar-high": "^2.6.4",
    "svix": "^2.9.1",
    "vinext": "^1.2.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    },
    "@sentry/bundler-plugins": {
      "glob": "^14.0.2"
    }
  },
  "type": "module",
  "license": "Apache-2.0"
}
